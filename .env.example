# LLM
# LLM_PROVIDER selects the backend used by get_llm(): "openai" (default) or "ollama".
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_MODEL=gemma-4-31b-cloud
OLLAMA_API_KEY=ollama

# Execution service (Node.js) — required
EXECUTION_SERVICE_URL=http://localhost:3000

# Mock server — required for mock-based testing
MOCK_SERVER_URL=

# FastAPI server
PRAXIS_AGENT_HOST=0.0.0.0
PRAXIS_AGENT_PORT=8000

# Experiment loop guard
PRAXIS_MAX_ITERATIONS=6

# Job polling (execution service async jobs)
PRAXIS_JOB_POLL_INTERVAL_SEC=2
PRAXIS_JOB_POLL_TIMEOUT_SEC=300

# Where every outbound execution-service / mock-server API call is logged (JSON lines)
PRAXIS_API_LOG_FILE=logs/api_calls.log
